# =============================================================
# backend/config/env.example
# 这是 Phase 2（搭新环境）才需要的配置清单。
# 当前线上后端仍在 WorkBuddy 托管云服务，本文件里的变量**暂不生效**。
# 真实值一律不写进仓库，只放部署环境的 Secret 里。
# =============================================================

# ---------- 后端（严禁进前端、严禁提交）----------
DATABASE_URL=postgresql://user:password@host:5432/fittogether
JWT_SECRET=              # 32 字节以上随机串，用于签发 session
SESSION_TTL_DAYS=30

# 邮件验证码
MAIL_PROVIDER=resend     # resend | ses | aliyun_dm
MAIL_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=减脂搭子

# 短信验证码（保留手机号登录就必须配）
SMS_PROVIDER=aliyun     # aliyun | tencent | twilio
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=          # 需审核通过的短信签名
SMS_TEMPLATE_CODE=      # 验证码模板 ID

# 频控（自建必须自己兜，平台不再代管）
OTP_RATE_PER_TARGET_PER_MIN=1
OTP_RATE_PER_TARGET_PER_DAY=10
OTP_RATE_PER_IP_PER_HOUR=20

# 安全开关：必须为 false，禁止客户端伪造归属
OWNER_ID_OVERRIDE=false

# CORS / Origin 白名单（精确匹配，不支持通配）
ALLOWED_ORIGINS=https://fit-together-44172.app.workbuddy.host,http://localhost:8080

# ---------- 前端（构建期注入，可以公开）----------
PUBLIC_API_BASE=https://api.example.com
PUBLIC_APP_ORIGIN=https://app.example.com
# 注意：PUBLIC_* 会被打包进前端，绝不能放任何密钥
