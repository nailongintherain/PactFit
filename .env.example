# PactFit 独立运行环境变量模板。
# 复制为 .env 后修改，或直接运行 scripts/dev-up.sh —— 脚本会自动生成含随机密钥的 .env。
# .env 含真实密钥，已被 .gitignore 排除，禁止提交。

# ---------- PostgreSQL ----------
# 数据库超级用户密码（容器内 postgres 用户）
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# 数据库名（db/init/01-roles.sql 中以固定名授权，若修改需同步改 01-roles.sql）
POSTGRES_DB=pactfit_dev

# ---------- 数据库角色密码 ----------
# PostgREST 连接用户（authenticator）
AUTHENTICATOR_PASSWORD=__AUTHENTICATOR_PASSWORD__
# GoTrue 连接用户（supabase_auth_admin，负责 auth schema 自动迁移）
GOTRUE_DB_PASSWORD=__GOTRUE_DB_PASSWORD__

# ---------- JWT ----------
# GoTrue 与 PostgREST 必须使用同一原始字节；首次启动建议由 dev-up.sh 随机生成
JWT_SECRET=__JWT_SECRET__
JWT_AUD=pactfit-local

# ---------- 端口（全部仅绑定 127.0.0.1） ----------
WEB_PORT=8899
GOTRUE_PORT=9999
POSTGREST_PORT=3000
MAILPIT_PORT=8025

# ---------- GoTrue 外部地址 ----------
# 邮件验证链接与跳转地址使用这两个值；换域名/端口时同步修改
SITE_URL=http://127.0.0.1:8899
API_EXTERNAL_URL=http://127.0.0.1:9999

# ---------- Mailpit SMTP（仅容器网内） ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ADMIN_EMAIL=admin@pactfit.local
